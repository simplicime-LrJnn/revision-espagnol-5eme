        let spanishVoices = [];

        function loadSpanishVoices() {
            if (!('speechSynthesis' in window)) return;
            const voices = window.speechSynthesis.getVoices();
            spanishVoices = voices.filter(v => v.lang && v.lang.toLowerCase().startsWith('es')).sort((a, b) => {
                const nameA = a.name.toLowerCase();
                const nameB = b.name.toLowerCase();
                const priority = ['google', 'mónica', 'jorge', 'monica', 'paulina', 'diego', 'natural', 'es-es', 'es-mx'];
                const scoreA = priority.reduce((acc, kw) => acc + (nameA.includes(kw) ? 10 : 0), 0);
                const scoreB = priority.reduce((acc, kw) => acc + (nameB.includes(kw) ? 10 : 0), 0);
                return scoreB - scoreA;
            });
        }

        if ('speechSynthesis' in window) {
            loadSpanishVoices();
            if (window.speechSynthesis.onvoiceschanged !== undefined) {
                window.speechSynthesis.onvoiceschanged = loadSpanishVoices;
            }
        }

        function pcmToWav(pcm16Array, sampleRate = 24000) {
            const buffer = new ArrayBuffer(44 + pcm16Array.length * 2);
            const view = new DataView(buffer);

            function writeString(offset, string) {
                for (let i = 0; i < string.length; i++) {
                    view.setUint8(offset + i, string.charCodeAt(i));
                }
            }

            writeString(0, 'RIFF');
            view.setUint32(4, 36 + pcm16Array.length * 2, true);
            writeString(8, 'WAVE');
            writeString(12, 'fmt ');
            view.setUint32(16, 16, true);
            view.setUint16(20, 1, true);
            view.setUint16(22, 1, true);
            view.setUint32(24, sampleRate, true);
            view.setUint32(28, sampleRate * 2, true);
            view.setUint16(32, 2, true);
            view.setUint16(34, 16, true);
            writeString(36, 'data');
            view.setUint32(40, pcm16Array.length * 2, true);

            for (let i = 0; i < pcm16Array.length; i++) {
                view.setInt16(44 + i * 2, pcm16Array[i], true);
            }

            return new Blob([view], { type: 'audio/wav' });
        }

        async function speakGeminiTTS(text, voiceName = "Aoede") {
            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-tts:generateContent?key=${apiKey}`;
            const rateSelect = document.getElementById('audio-speed');
            const speed = parseFloat(rateSelect ? rateSelect.value : 1.0);

            const promptInstruction = speed < 1.0 
                ? `Di esto con pronunciación nativa de España, marcando bien cada palabra de forma pausada y muy clara: "${text}"`
                : `Di esto con una voz en español nativo, cálida, fluida y natural: "${text}"`;

            const payload = {
                contents: [{
                    parts: [{ text: promptInstruction }]
                }],
                generationConfig: {
                    responseModalities: ["AUDIO"],
                    speechConfig: {
                        voiceConfig: {
                            prebuiltVoiceConfig: { voiceName: voiceName }
                        }
                    }
                },
                model: "gemini-2.5-flash-preview-tts"
            };

            const response = await fetch(apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            const result = await response.json();
            const part = result?.candidates?.[0]?.content?.parts?.[0];
            const base64Data = part?.inlineData?.data;
            const mimeType = part?.inlineData?.mimeType || "";

            if (base64Data) {
                const sampleRateMatch = mimeType.match(/rate=(\d+)/);
                const sampleRate = sampleRateMatch ? parseInt(sampleRateMatch[1], 10) : 24000;
                
                const binaryString = atob(base64Data);
                const bytes = new Uint8Array(binaryString.length);
                for (let i = 0; i < binaryString.length; i++) {
                    bytes[i] = binaryString.charCodeAt(i);
                }
                const pcm16 = new Int16Array(bytes.buffer);
                const wavBlob = pcmToWav(pcm16, sampleRate);
                const audioUrl = URL.createObjectURL(wavBlob);
                const audio = new Audio(audioUrl);
                audio.play();
                return true;
            }
            return false;
        }

        async function speak(text) {
            const engineSelect = document.getElementById('audio-engine');
            const selectedVal = engineSelect ? engineSelect.value : 'gemini-Aoede';

            if (selectedVal.startsWith('gemini-')) {
                const voiceName = selectedVal.replace('gemini-', '');
                try {
                    const success = await speakGeminiTTS(text, voiceName);
                    if (success) return;
                } catch (err) {
                    console.warn("Gemini TTS fallback to native voice:", err);
                }
            }

            if (!('speechSynthesis' in window)) return;

            window.speechSynthesis.cancel();

            if (spanishVoices.length === 0) {
                loadSpanishVoices();
            }

            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'es-ES';

            if (spanishVoices.length > 0) {
                utterance.voice = spanishVoices[0];
            }

            const rateSelect = document.getElementById('audio-speed');
            const speed = parseFloat(rateSelect ? rateSelect.value : 1.0);
            utterance.rate = speed;

            window.speechSynthesis.speak(utterance);
        }

        // --- NAVIGATION ---
        function switchTab(tabId) {
            document.querySelectorAll('section').forEach(s => s.classList.add('hidden'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));

            document.getElementById(`sec-${tabId}`).classList.remove('hidden');
            document.getElementById(`tab-${tabId}`).classList.add('active');

            if(tabId === 'vocab') {
                renderVocab('all');
            }
        }

        // --- VOCABULARY RENDERER ---
        function renderVocab(category) {
            const grid = document.getElementById('vocab-grid');
            grid.innerHTML = '';

            const filtered = category === 'all' 
                ? vocabulary 
                : vocabulary.filter(v => v.cat === category);

            filtered.forEach(item => {
                const card = document.createElement('div');
                card.className = "bg-white p-3.5 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between hover:border-red-200 transition";
                card.innerHTML = `
                    <div>
                        <div class="font-bold text-slate-800 text-base flex items-center gap-1.5">
                            ${item.text}
                        </div>
                        <div class="text-xs text-slate-500 capitalize">${item.translation}</div>
                    </div>
                    <button onclick="speak('${item.text.replace(/'/g, "\\'")}')" class="p-2.5 bg-red-50 hover:bg-red-100 text-red-600 rounded-lg transition" title="Escuchar">
                        🔊
                    </button>
                `;
                grid.appendChild(card);
            });
        }

        function filterVocab(cat) {
            document.querySelectorAll('.vocab-filter-btn').forEach(b => {
                b.classList.remove('bg-red-600', 'text-white');
                b.classList.add('bg-slate-200', 'text-slate-700');
            });
            event.target.classList.remove('bg-slate-200', 'text-slate-700');
            event.target.classList.add('bg-red-600', 'text-white');

            renderVocab(cat);
        }

        let currentQuizMode = null;
        let currentQuestionIndex = 0;
        let score = 0;
        let activeQuestions = [];

        function startQuizMode(mode) {
            currentQuizMode = mode;
            currentQuestionIndex = 0;
            score = 0;

            const container = document.getElementById('quiz-container');
            container.classList.remove('hidden');

            if (mode === 'mcq') {
                activeQuestions = [...questionsMCQ].sort(() => 0.5 - Math.random()).slice(0, 10);
            } else if (mode === 'listening') {
                activeQuestions = generateListeningQuestions();
            } else if (mode === 'verbs') {
                activeQuestions = generateVerbQuestions();
            }

            updateScoreDisplay();
            renderCurrentQuestion();
        }

        function generateListeningQuestions() {
            const shuffledVocab = [...vocabulary].sort(() => 0.5 - Math.random()).slice(0, 10);
            
            return shuffledVocab.map(item => {
                const wrongList = vocabulary.filter(v => v.text !== item.text).sort(() => 0.5 - Math.random()).slice(0, 3);
                const options = [item, ...wrongList].sort(() => 0.5 - Math.random());
                return {
                    isAudio: true,
                    audioText: item.text,
                    q: "Écoute le mot ou la phrase en espagnol et choisis la traduction :",
                    options: options.map(o => o.translation),
                    answer: options.findIndex(o => o.text === item.text),
                    explain: `L'enregistrement disait : "${item.text}" (${item.translation}).`
                };
            });
        }

        function generateVerbQuestions() {
            const verbData = [
                { text: "Yo ___ Nathanaël. (S'appeler)", options: ["me llamo", "te llamas", "se llama", "soy"], answer: 0, exp: "Yo me llamo" },
                { text: "Tú ___ doce años. (Avoir)", options: ["tienes", "tengo", "tiene", "eres"], answer: 0, exp: "Tú tienes" },
                { text: "Yo ___ un alumno del colegio. (Être)", options: ["soy", "eres", "es", "tengo"], answer: 0, exp: "Yo soy" },
                { text: "Él ___ en Ternuay. (Habiter)", options: ["vive", "vivo", "vives", "viven"], answer: 0, exp: "Él vive" },
                { text: "Tú ___ un alumno del colegio. (Être)", options: ["eres", "soy", "es", "son"], answer: 0, exp: "Tú eres" },
                { text: "Ella ___ doce años. (Avoir)", options: ["tiene", "tengo", "tienes", "son"], answer: 0, exp: "Ella tiene" },
                { text: "Yo ___ en Ternuay. (Habiter)", options: ["vivo", "vives", "vive", "viven"], answer: 0, exp: "Yo vivo" },
                { text: "Ellos ___ del colegio. (Être)", options: ["son", "es", "soy", "somos"], answer: 0, exp: "Ellos son" },
                { text: "Tú ___ en Francia. (Habiter)", options: ["vives", "vivo", "vive", "viven"], answer: 0, exp: "Tú vives" },
                { text: "Él ___ un alumno muy simpático. (Être)", options: ["es", "soy", "eres", "son"], answer: 0, exp: "Él es" }
            ];

            return verbData.sort(() => 0.5 - Math.random());
        }

        function updateScoreDisplay() {
            document.getElementById('quiz-score').innerText = `Score : ${score}/${activeQuestions.length}`;
            document.getElementById('quiz-progress').innerText = `Question ${currentQuestionIndex + 1}/${activeQuestions.length}`;
        }

        function renderCurrentQuestion() {
            const q = activeQuestions[currentQuestionIndex];
            const body = document.getElementById('quiz-body');
            const feedback = document.getElementById('quiz-feedback');
            const nextBtn = document.getElementById('next-q-btn');

            feedback.classList.add('hidden');
            nextBtn.classList.add('hidden');

            let html = `<h3 class="text-lg font-bold text-slate-800 mb-4">${q.q}</h3>`;

            if (q.isAudio) {
                html += `
                    <div class="mb-4">
                        <button onclick="speak('${q.audioText.replace(/'/g, "\\'")}')" class="px-4 py-2.5 bg-red-600 hover:bg-red-700 text-white rounded-xl font-medium shadow inline-flex items-center gap-2">
                            🔊 Escuchar / Écouter
                        </button>
                    </div>
                `;
            } else if (q.text) {
                html += `
                    <div class="mb-4 p-4 bg-amber-50 rounded-xl text-center text-xl font-bold text-amber-900 border border-amber-200">
                        ${q.text}
                    </div>
                `;
            }

            html += `<div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">`;
            q.options.forEach((opt, idx) => {
                html += `
                    <button onclick="checkAnswer(${idx})" class="quiz-opt-btn text-left p-3.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-xl text-sm font-medium transition">
                        ${opt}
                    </button>
                `;
            });
            html += `</div>`;

            body.innerHTML = html;

            if (q.isAudio) {
                setTimeout(() => speak(q.audioText), 300);
            }
        }

        function checkAnswer(selectedIndex) {
            const q = activeQuestions[currentQuestionIndex];
            const buttons = document.querySelectorAll('.quiz-opt-btn');
            const feedback = document.getElementById('quiz-feedback');
            const nextBtn = document.getElementById('next-q-btn');

            buttons.forEach(b => b.disabled = true);

            if (selectedIndex === q.answer) {
                score++;
                buttons[selectedIndex].classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-900');
                feedback.className = "mt-4 p-3 rounded-xl text-sm font-medium bg-emerald-50 text-emerald-800 border border-emerald-200";
                feedback.innerHTML = `✅ <strong>¡Muy bien!</strong> ${q.explain || q.exp || ''}`;
            } else {
                buttons[selectedIndex].classList.add('bg-red-100', 'border-red-500', 'text-red-900');
                buttons[q.answer].classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-900');
                feedback.className = "mt-4 p-3 rounded-xl text-sm font-medium bg-red-50 text-red-800 border border-red-200";
                feedback.innerHTML = `❌ <strong>¡Casi!</strong> ${q.explain || q.exp || ''}`;
            }

            feedback.classList.remove('hidden');
            nextBtn.classList.remove('hidden');
            updateScoreDisplay();
        }

        function nextQuestion() {
            currentQuestionIndex++;
            if (currentQuestionIndex < activeQuestions.length) {
                updateScoreDisplay();
                renderCurrentQuestion();
            } else {
                renderFinalScore();
            }
        }

        function renderFinalScore() {
            const body = document.getElementById('quiz-body');
            document.getElementById('next-q-btn').classList.add('hidden');
            document.getElementById('quiz-feedback').classList.add('hidden');

            const percentage = Math.round((score / activeQuestions.length) * 100);
            let message = percentage >= 80 ? "¡Excelente! 🏆 ¡Dominas la Secuencia 1!" : "¡Sigue practicando! Revisa las notas de la lección.";

            body.innerHTML = `
                <div class="text-center py-6">
                    <span class="text-5xl mb-3 block">${percentage >= 80 ? '🏆' : '👍'}</span>
                    <h3 class="text-2xl font-bold font-fun text-slate-800">¡Test Finalizado!</h3>
                    <p class="text-lg font-semibold text-red-600 mt-1">Score : ${score} / ${activeQuestions.length} (${percentage}%)</p>
                    <p class="text-sm text-slate-600 mt-2">${message}</p>
                    <button onclick="startQuizMode('${currentQuizMode}')" class="mt-6 bg-red-600 hover:bg-red-700 text-white px-6 py-2.5 rounded-xl font-semibold shadow transition">
                        Recommencer le quiz 🔄
                    </button>
                </div>
            `;
        }

        window.onload = function() {
            switchTab('notes');
        };
    </script>
